#!/usr/bin/env bash
# clacc: switch Claude Code accounts, for every running session at once or for one new session.
# https://github.com/zauberzeug/clacc, MIT license. Run `clacc --help` for the commands.
#
# Every session reads its token from ~/.claude/.credentials.json and reloads it when the
# file changes, so replacing that file switches them all. The account record (email,
# organisation) sits in ~/.claude.json and is replaced with it. An inactive account's
# token waits in ~/.clacc/<name>.credentials.json. Each token exists in one place only:
# a session that refreshes one copy leaves every other copy with a dead refresh token.
#
# On macOS Claude Code keeps logins in the Keychain instead, so clacc keeps them there too: see
# keychain_service for the item of each. A session rereads its item every 30 seconds.
#
# A `run` session uses ~/.clacc/<name>.local as its config folder (CLAUDE_CONFIG_DIR): a
# login and a .claude.json of its own, and links to ~/.claude for settings, skills, plugins,
# projects and memory. It cannot share ~/.claude.json, because a session that starts after
# the stored profile is a day old writes the account of its own token there.
#
# Without a name, switch and run ask Claude Code for the /usage of every stored account and take
# the one with the most headroom. Claude Code renews an expired token on its own, so clacc never
# reads a token value to compare accounts.
set -euo pipefail
umask 077
unset CLAUDE_SECURESTORAGE_CONFIG_DIR # it would move the token folder of every claude started here

store=${CLACC_HOME:-$HOME/.clacc}
# Claude Code's own folder: the default one, or CLAUDE_CONFIG_DIR. Inside a `clacc run` session
# CLAUDE_CONFIG_DIR is that session's folder, and CLACC_CLAUDE_CONFIG_DIR keeps the caller's.
global=${CLACC_CLAUDE_CONFIG_DIR-${CLAUDE_CONFIG_DIR-}}
case $global in "$store"/*) global="" ;; esac
if [[ -n $global ]]; then
  claude_dir=$global config=$global/.claude.json
else
  claude_dir=$HOME/.claude config=$HOME/.claude.json
fi
token=$claude_dir/.credentials.json
# Held while a parked token is lent out to read its usage: a switch must not move it meanwhile.
lent_lock=$store/.lent.lock
# What a `run` session shares with Claude Code's own folder; everything else in its folder is its own.
shared_dirs=(projects skills agents commands output-styles plugins plans agent-memory todos file-history paste-cache shell-snapshots session-env sessions ide)
shared_files=(CLAUDE.md keybindings.json history.jsonl statusline-command.sh)
# The settings a `run` folder keeps for its own account, because another account may not offer them.
own_settings='["model"]'
held=()
login_dir=""
lent=""
picked=""
new_copy=""
keychain_user="" # set on macOS, where the logins are in the Keychain

main() {
  if [[ ${1:-} == -h || ${1:-} == --help ]]; then usage 0; fi
  case $(uname -s) in
    Linux) ;;
    Darwin) keychain_user=${USER:-$(id -un)} ;;
    *) die "clacc needs Linux or macOS" ;;
  esac
  trap cleanup EXIT
  # An update needs neither jq nor the store.
  if [[ ${1:-} == update ]]; then
    [[ $# -eq 1 ]] || usage
    update
    return
  fi
  command -v jq > /dev/null || die "clacc needs jq (https://jqlang.org)"
  mkdir -p "$store"
  case "${1:-}" in
    "" | status) [[ $# -le 1 ]] || usage; status ;;
    switch)
      [[ $# -le 2 ]] || usage
      if [[ $# -eq 2 ]]; then picked=$2; else pick_account switch; fi
      switch "$picked"
      ;;
    add | save) [[ $# -eq 2 ]] || usage; "$1" "$2" ;;
    rename) [[ $# -eq 3 ]] || usage; rename_account "$2" "$3" ;;
    run) shift; run_local "$@" ;;
    *)
      # A name alone switches nothing: moving every session takes the explicit command.
      if [[ $1 != -* && -f $store/$1.account.json ]]; then warn "to move every session to $1: clacc switch $1"; fi
      usage
      ;;
  esac
}

usage() {
  if [[ ${1:-2} != 0 ]]; then exec >&2; fi
  cat << 'EOF'
clacc [status]              show the active account and the stored ones
clacc switch [name]         switch all sessions, running ones included, to [name]
clacc run [name] [args...]  start one session on [name]'s own login, passing args to claude
clacc add <name>            sign in to another account without touching the active one
clacc save <name>           store the active login under <name>, e.g. after a manual /login
clacc rename <old> <new>    give a stored account another name
clacc update                get the newest clacc from the main branch

Without a name, switch and run take the account with the most headroom. A first word after
run that is not an option is a name, so a prompt needs a leading --: clacc run -- "fix it"
EOF
  exit "${1:-2}"
}

status() {
  local name current dir
  current=$(active_name)
  echo "active: ${current:-not stored} ($(active_email))"
  for name in $(stored_names); do
    if [[ $name == "$current" ]]; then continue; fi
    if has_token "$store/$name.credentials.json"; then
      echo "stored: $name ($(email_of "$name"))"
    else
      echo "stored: $name ($(email_of "$name")), no token: clacc add $name"
    fi
  done
  for dir in "$store"/*.local; do
    if [[ ! -d $dir ]]; then continue; fi
    name=$(basename "$dir" .local)
    echo "local:  $name ($(jq -r '.oauthAccount.emailAddress // "no login yet"' "$dir/.claude.json" 2> /dev/null || echo "no login yet")), for single sessions: clacc run $name"
  done
}

switch() {
  local target=$1 current follow="at their next request"
  check_name "$target"
  [[ -f $store/$target.account.json ]] || die "no stored account '$target' (stored: $(stored_names | xargs))"
  has_token "$token" || die "there is no active login"
  lock_all
  current=$(active_name)
  [[ -n $current ]] || die "the active login ($(active_email)) is not stored; name it first: clacc save <name>"
  if [[ $current == "$target" ]]; then
    echo "already on $target ($(active_email))"
    return
  fi
  has_token "$store/$target.credentials.json" || die "no token stored for $target; sign in once: clacc add $target"
  read_token "$store/$target.credentials.json" | jq -e .claudeAiOauth.accessToken > /dev/null || die "the stored token for $target is unreadable"
  jq_to "$store/$current.account.json" .oauthAccount "$config"
  swap_tokens "$current" "$target"
  set_record "$store/$target.account.json"
  unlock_all
  if [[ -n $keychain_user ]]; then follow="within 30 seconds"; fi
  echo "switched from $current to $target ($(active_email)); running sessions follow $follow"
}

swap_tokens() {
  local current=$1 target=$2 active
  if [[ -n $keychain_user ]]; then
    active=$(read_token "$token")
    keychain_write "$store/$current.credentials.json" "$active"
    move_token "$store/$target.credentials.json" "$token"
    return
  fi
  ln -f "$token" "$store/$current.credentials.json" # park the active token under a second name,
  chmod 600 "$store/$target.credentials.json"       # keep the target's token readable by you only,
  touch "$store/$target.credentials.json"           # give it a new modification time so every session notices,
  mv -f "$store/$target.credentials.json" "$token"  # then put it in the active token's place
}

# One session on an account's own login, with the remaining arguments passed to claude: the account
# named first, or else the one with the most headroom. The first session start signs in, in the browser.
run_local() {
  local name=${1:-} dir want
  local sign_in=(auth login --claudeai)
  case $name in
    "" | -*)
      pick_account run
      name=$picked
      ;;
    *) shift ;;
  esac
  if [[ ${1:-} == -- ]]; then shift; fi
  check_name "$name"
  dir=$store/$name.local
  prepare_local "$dir"
  export CLACC_CLAUDE_CONFIG_DIR=$global
  export CLAUDE_CONFIG_DIR=$dir
  if ! has_token "$dir/.credentials.json" && starts_session "$@"; then
    [[ -t 0 && -t 1 ]] || die "$name has no login of its own yet; start it once in a terminal to sign in"
    want=$(jq -r '.emailAddress // empty' "$store/$name.account.json" 2> /dev/null || true)
    if [[ -n $want ]]; then sign_in+=(--email "$want"); fi
    echo "First start on $name: sign in once${want:+ as $want} in the browser."
    claude "${sign_in[@]}" || die "no login happened"
  fi
  if [[ ${1:-} != auth ]]; then check_local_account "$name" "$dir"; fi
  exec claude "$@"
}

# Put the stored account with the most headroom into $picked. What it compares goes to stderr,
# since in a `run` stdout is claude's. A tie stays on the active account, so a tie moves nobody.
# A `switch` needs the active or a parked login; a `run` also takes the own login of a run folder.
pick_account() {
  local command=$1 name current parked own usage_text summary left detail best=-1
  current=$(active_name)
  if [[ -z $current ]]; then echo "the active login ($(active_email)) is not stored, so not compared: clacc save <name>" >&2; fi
  for name in $(stored_names); do
    parked=$store/$name.credentials.json own=$store/$name.local/.credentials.json
    if [[ $name == "$current" ]]; then
      usage_text=$(claude_usage "$global")
    elif has_token "$own" && { [[ $command == run ]] || has_token "$parked"; }; then
      usage_text=$(claude_usage "$store/$name.local")
    elif has_token "$parked"; then
      read_parked "$name"
    else
      echo "$name: no token, not compared: clacc add $name" >&2
      continue
    fi
    if summary=$(headroom "$usage_text"); then
      read -r left detail <<< "$summary"
      echo "$name: $left% left $detail" >&2
      if ((left > best)) || { ((left == best)) && [[ $name == "$current" ]]; }; then
        best=$left picked=$name
      fi
    else
      echo "$name: could not read its usage, not compared" >&2
    fi
  done
  [[ -n $picked ]] || die "could not read the usage of any account; name one: clacc $command <name>"
  ((best > 0)) || die "no account has headroom left; name one: clacc $command <name>"
  echo "most headroom: $picked" >&2
}

# A parked token waits outside any config folder, so a reading lends it one, where Claude Code may
# renew it. The lock keeps a switch from moving it meanwhile. close_login_dir brings it back.
read_parked() {
  take_lock "$lent_lock"
  lent=$1
  login_dir=$(mktemp -d "$store/login.XXXXXX")
  seed_config "$login_dir"
  move_token "$store/$lent.credentials.json" "$login_dir/.credentials.json"
  usage_text=$(claude_usage "$login_dir")
  close_login_dir
  unlock_all
}

# The /usage text from Claude Code in a config folder ("" is its default one), run from the store,
# away from any project. /usage is a local command here and sends no prompt; the cheap model only
# matters should a later version send it after all.
claude_usage() {
  (
    cd "$store"
    if [[ -n $1 ]]; then export CLAUDE_CONFIG_DIR=$1; else unset CLAUDE_CONFIG_DIR; fi
    claude -p /usage --safe-mode --no-session-persistence --model haiku < /dev/null 2> /dev/null || true
  )
}

# "<percent left> (<what is used>)" from a /usage text: the tighter of the five-hour and the weekly
# limit. A limit on a single model does not count, and a text with neither limit fails.
headroom() {
  local hours week tightest
  hours=$(sed -n 's/^Current session: \([0-9]*\)% used.*/\1/p' <<< "$1")
  week=$(sed -n 's/^Current week (all models): \([0-9]*\)% used.*/\1/p' <<< "$1")
  [[ -n $hours$week ]] || return 1
  tightest=${hours:-0}
  if ((${week:-0} > tightest)); then tightest=$week; fi
  if ((tightest > 100)); then tightest=100; fi
  echo "$((100 - tightest)) (five hours ${hours:-?}% used, week ${week:-?}% used)"
}

# Whether claude arguments start a session: none at all, or options such as -c or --model.
# Help, the version and subcommands such as mcp or auth need no login, and a call that begins
# with a prompt signs in through claude's own /login.
starts_session() {
  case ${1:-} in
    "") return 0 ;;
    -h | --help | -v | --version) return 1 ;;
    -*) return 0 ;;
    *) return 1 ;;
  esac
}

# A login of the wrong account or organisation would run every later `run` session on it.
check_local_account() {
  local name=$1 dir=$2 verdict
  local who='"\(.emailAddress) in \(.organizationName // "no organisation")"'
  # shellcheck disable=SC2016 # $w and $g are jq variables
  verdict=$(jq -rn --slurpfile w "$store/$name.account.json" --slurpfile g "$dir/.claude.json" '
    $w[0] as $w | $g[0].oauthAccount as $g
    | if $g == null then "ok"
      elif $g.accountUuid != $w.accountUuid then "other"
      elif $g.organizationUuid and $w.organizationUuid and $g.organizationUuid != $w.organizationUuid then "other"
      else "ok" end' 2> /dev/null || echo ok)
  [[ $verdict == ok ]] || die "the own login of $name is $(jq -r ".oauthAccount | $who" "$dir/.claude.json"), not $(jq -r "$who" "$store/$name.account.json"); remove it with: $(remove_command "$dir/.credentials.json")"
}

prepare_local() {
  local dir=$1 entry
  mkdir -p "$dir"
  if [[ ! -f $dir/.claude.json ]]; then seed_config "$dir"; fi
  for entry in "${shared_dirs[@]}"; do
    mkdir -p "$claude_dir/$entry"
    share "$dir" "$entry"
  done
  for entry in "${shared_files[@]}"; do
    if [[ -e $claude_dir/$entry || -e $dir/$entry ]]; then share "$dir" "$entry"; fi
  done
  sync_settings "$dir"
}

# A run folder's settings.json is a file of its own: the shared settings, plus the folder's own
# model once one of its sessions picked one with /model. Any other change a session made there
# goes back to the shared file at the next start; when the shared file changed the same setting
# meanwhile, the shared value stays. So /model in one account never sets another account's model.
sync_settings() {
  local dir=$1
  local shared=$claude_dir/settings.json own=$dir/settings.json base=$dir/.settings-base.json keep=$dir/.settings-own.json current=null out mode
  if [[ -f $own ]] && ! current=$(jq -c . "$own" 2> /dev/null); then
    warn "$own is not valid JSON; the changes in it are dropped"
    current=null
  fi
  # A missing or unreadable folder file, or a missing base, counts as no change at all.
  # Settings can hold secrets such as API keys, so they reach jq through pipes and stay off its
  # command line, which other processes can read.
  # shellcheck disable=SC2016 # $s, $o, $b, $k and $only are jq variables
  out=$(jq -n --argjson only "$own_settings" --slurpfile o <(printf '%s\n' "$current") \
    --slurpfile s <(jq -c . "$shared" 2> /dev/null || echo '{}') \
    --slurpfile b <(jq -c . "$base" 2> /dev/null || echo null) \
    --slurpfile k <(jq -c . "$keep" 2> /dev/null || echo '{}') '
    ($b[0] // $o[0] // {}) as $b | ($o[0] // $b) as $o | $s[0] as $s | $k[0] as $k
    | [[$o, $b] | map(keys[]) | unique[] | select($o[.] != $b[.])] as $changed
    | ($k + ([$changed[] | select(IN($only[])) | {(.): $o[.]}] | add // {}) | with_entries(select(.value != null))) as $k
    | [$changed[] | select(IN($only[]) | not)] as $session
    | [$session[] | select($s[.] == $b[.])] as $push
    | (reduce $push[] as $key ($s; if $o | has($key) then .[$key] = $o[$key] else del(.[$key]) end)) as $s2
    | {shared: (if $push == [] then null else $s2 end), kept: [$session[] | select($s[.] != $b[.] and $s[.] != $o[.])], keep: $k, own: ($s2 + $k)}')
  if [[ $(jq -c .shared <<< "$out") != null ]]; then
    mode=$(file_mode "$shared" || echo 600)
    jq_to "$shared" .shared <<< "$out"
    chmod "$mode" "$shared"
  fi
  if [[ $(jq -c .kept <<< "$out") != "[]" ]]; then
    warn "kept the shared value of $(jq -r '.kept | join(", ")' <<< "$out"), which a session of $(basename "$dir" .local) changed too"
  fi
  jq_to "$keep" .keep <<< "$out"
  jq_to "$own" .own <<< "$out"
  jq_to "$base" .own <<< "$out"
}

# Link <entry> of a run folder to Claude Code's own folder. One that a session made there
# before Claude Code's folder had it moves over first.
share() {
  local dir=$1 entry=$2
  if [[ -L $dir/$entry ]]; then return 0; fi
  if [[ -e $dir/$entry ]]; then
    if [[ ! -e $claude_dir/$entry ]]; then mv -n "$dir/$entry" "$claude_dir/$entry"; fi
    if [[ -e $dir/$entry ]]; then
      warn "$dir/$entry is not shared with $claude_dir/$entry; remove one of the two to share it"
      return 0
    fi
  fi
  ln -s "$claude_dir/$entry" "$dir/$entry"
}

# .claude.json without the account record and without what Claude Code keeps per account or
# organisation: caches, feature flags, consent and plan offers.
seed_config() {
  if [[ ! -f $config ]]; then
    echo '{}' > "$1/.claude.json"
    return
  fi
  jq_to "$1/.claude.json" '
    del(.oauthAccount)
    | with_entries(select(.key | test("[Cc]ache|Roster|Eligibility|OrgEnabled|ExtraUsage|^grove|^passes|^claudeAiMcp|^additionalModel|^orgModel|^modelAccess|^clientData|^apiCreditLink|^promoStartup|^replBridge") | not))
    | if .projects then .projects |= map_values(del(.hasUnseenTeamArtifacts, .loggedAuthoredArtifactPaths)) else . end' "$config"
}

# The login runs in a config folder of its own, so it never touches the shared .claude.json.
# cleanup removes that folder however add ends.
add() {
  local name=$1 record uuid other
  check_name "$name"
  ! has_token "$store/$name.credentials.json" || die "$name is already stored"
  [[ $name != "$(active_name)" ]] || die "$name is the active login"
  login_dir=$(mktemp -d "$store/login.XXXXXX")
  seed_config "$login_dir"
  echo "Sign in as $name in the browser. Every session keeps its account meanwhile."
  if ! CLAUDE_CONFIG_DIR=$login_dir claude auth login --claudeai || ! has_token "$login_dir/.credentials.json"; then
    die "no login happened; nothing changed"
  fi
  record=$(jq -c '.oauthAccount // empty' "$login_dir/.claude.json")
  uuid=$(jq -r '.accountUuid // empty' <<< "$record")
  [[ -n $uuid ]] || die "the login left no account record; nothing stored"
  other=$(name_of "$uuid")
  [[ -z $other || $other == "$name" ]] || die "you signed in as $(jq -r .emailAddress <<< "$record"), which is already stored as $other; nothing stored"
  [[ ! -f $store/$name.account.json || $(jq -r .accountUuid "$store/$name.account.json") == "$uuid" ]] || die "you signed in as $(jq -r .emailAddress <<< "$record"), but $name is $(email_of "$name"); nothing stored"
  # shellcheck disable=SC2016 # $r is a jq variable
  jq_to "$store/$name.account.json" -n --argjson r "$record" '$r'
  move_token "$login_dir/.credentials.json" "$store/$name.credentials.json"
  echo "stored $name ($(email_of "$name")); every session keeps its account"
}

save() {
  local name=$1 uuid other
  check_name "$name"
  lock_all
  uuid=$(jq -r '.oauthAccount.accountUuid // empty' "$config")
  [[ -n $uuid ]] || die "there is no active login to store"
  other=$(name_of "$uuid")
  [[ -z $other || $other == "$name" ]] || die "the active login is already stored as $other"
  [[ ! -f $store/$name.account.json || $other == "$name" ]] || die "$name is another account; pick another name"
  jq_to "$store/$name.account.json" .oauthAccount "$config"
  unlock_all
  echo "stored the active login ($(active_email)) as $name"
}

# A name is only a file name: the active account is found by its account id, not by its name.
rename_account() {
  local old=$1 new=$2
  check_name "$old"
  check_name "$new"
  [[ -f $store/$old.account.json ]] || die "no stored account '$old' (stored: $(stored_names | xargs))"
  [[ ! -e $store/$new.account.json ]] || die "$new is already taken"
  ! has_token "$store/$new.credentials.json" || die "$new is already taken"
  lock_all
  mv "$store/$old.account.json" "$store/$new.account.json"
  if has_token "$store/$old.credentials.json"; then move_token "$store/$old.credentials.json" "$store/$new.credentials.json"; fi
  unlock_all
  echo "renamed $old to $new"
}

# Put the newest clacc from main in this copy's place. Read from standard input or sourced, $0 only
# names the bash, which a file in this folder can share. A clone belongs to git. The rename leaves
# the old file to the bash still reading it. A download whose help starts with anything else, such
# as a web page, an empty file or a file cut off, never replaces a clacc that works.
update() {
  local self=$0 folder
  folder=$(dirname "$self")
  [[ ${BASH_SOURCE[0]:-} == "$self" && ! -L $self && ! -e $folder/.git ]] || die "cannot update $self: it is not an installed copy; in a clone use git pull"
  [[ -w $folder ]] || die "cannot update $self: its folder is not writable"
  new_copy=$self.tmp.$$
  curl -fsSL https://raw.githubusercontent.com/zauberzeug/clacc/main/clacc -o "$new_copy"
  chmod "$(file_mode "$self")" "$new_copy"
  [[ $(bash "$new_copy" --help 2> /dev/null < /dev/null) == clacc* ]] || die "the download does not run; nothing changed"
  if cmp -s "$new_copy" "$self"; then
    echo "clacc is up to date"
    return
  fi
  mv -f "$new_copy" "$self"
  echo "updated clacc to the newest version"
}

# The stored name whose record carries this account id.
name_of() {
  local name
  [[ -n $1 ]] || return 0
  for name in $(stored_names); do
    if [[ $(jq -r .accountUuid "$store/$name.account.json") == "$1" ]]; then
      echo "$name"
      return 0
    fi
  done
}

active_name() { name_of "$(jq -r '.oauthAccount.accountUuid // empty' "$config")"; }
active_email() { jq -r '.oauthAccount.emailAddress // "no account record"' "$config"; }
email_of() { jq -r .emailAddress "$store/$1.account.json"; }

stored_names() {
  local f
  for f in "$store"/*.account.json; do
    if [[ -e $f ]]; then basename "$f" .account.json; fi
  done
}

check_name() {
  [[ $1 =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "use a name of lowercase letters, digits, dots, - or _, beginning with a letter or digit"
}

# shellcheck disable=SC2016 # $r is a jq variable
set_record() { jq_to "$config" --slurpfile r "$1" '.oauthAccount = $r[0]' "$config"; }

# Write a jq result atomically: a reader sees the old file or the new one, never half of one.
jq_to() {
  local dest=$1
  shift
  jq "$@" > "$dest.tmp.$$"
  mv -f "$dest.tmp.$$" "$dest"
}

# The lock of a reading first, then the ones Claude Code takes around a token refresh, a token write
# and a config write.
lock_all() {
  local lock real
  real=$(cd -P "$claude_dir" 2> /dev/null && pwd -P) || real=$claude_dir
  for lock in "$lent_lock" "$claude_dir/.oauth_refresh.lock" "$real.lock" "$claude_dir/.storage-write.lock" "$config.lock"; do take_lock "$lock"; done
}

# mkdir is the lock, as in Claude Code's lock library, which counts a lock untouched for 60 s as stale.
take_lock() {
  local lock=$1 tries
  for ((tries = 0; tries < 100; tries++)); do
    if mkdir "$lock" 2> /dev/null; then
      held+=("$lock")
      return 0
    fi
    if (($(date +%s) - $(file_time "$lock" || date +%s) > 60)); then rm -rf "$lock"; fi
    sleep 0.1
  done
  die "$lock is held by another process; try again in a minute"
}

unlock_all() {
  local lock
  for lock in ${held[@]+"${held[@]}"}; do rmdir "$lock" 2> /dev/null || true; done
  held=()
}

# On every exit: close a login folder, remove the download of an update, then release the locks.
cleanup() {
  close_login_dir
  if [[ -n $new_copy ]]; then rm -f "$new_copy"; fi
  unlock_all
}

# Remove the login folder of an add or a reading, with the refresh lock Claude Code may have made
# beside it. A lent token goes back first, however the reading ended: Claude Code may have renewed
# it, which can retire the refresh token it came with.
close_login_dir() {
  if [[ -z $login_dir ]]; then return 0; fi
  if [[ -n $lent ]] && has_token "$login_dir/.credentials.json"; then move_token "$login_dir/.credentials.json" "$store/$lent.credentials.json"; fi
  if [[ -n $keychain_user ]]; then keychain_delete "$login_dir/.credentials.json" || true; fi
  rm -rf "$login_dir" "$login_dir.lock"
  login_dir="" lent=""
}

# GNU stat first: BSD stat refuses -c, while GNU stat reads -f as something else.
file_mode() { stat -c %a "$1" 2> /dev/null || stat -f %Lp "$1" 2> /dev/null; }
file_time() { stat -c %Y "$1" 2> /dev/null || stat -f %m "$1" 2> /dev/null; }

# A token's place is named by a file path. On Linux it is that file; on macOS the path picks a
# Keychain item, because a token kept beside the Keychain would be less protected than the one in it.
has_token() {
  if [[ -z $keychain_user ]]; then
    [[ -f $1 ]]
  else
    security find-generic-password -a "$keychain_user" -s "$(keychain_service "$1")" > /dev/null 2>&1
  fi
}

read_token() {
  local value
  if [[ -z $keychain_user ]]; then
    cat "$1"
    return
  fi
  value=$(security find-generic-password -a "$keychain_user" -s "$(keychain_service "$1")" -w) || return 1
  # security prints a value with non-ASCII characters as hex.
  if [[ $value =~ ^[0-9a-f]+$ ]]; then value=$(printf %s "$value" | xxd -r -p) || return 1; fi
  printf '%s\n' "$value"
}

# No atomic rename in the Keychain: the old place goes only once the new one reads back correctly.
move_token() {
  local value
  if [[ -z $keychain_user ]]; then
    mv -f "$1" "$2"
    return
  fi
  value=$(read_token "$1")
  keychain_write "$2" "$value"
  keychain_delete "$1" || die "could not remove the old copy in '$(keychain_service "$1")'"
}

remove_command() {
  if [[ -z $keychain_user ]]; then
    echo "rm $1"
  else
    echo "security delete-generic-password -a $keychain_user -s \"$(keychain_service "$1")\""
  fi
}

# The item Claude Code uses for a config folder: a plain name for its default folder, and a hash
# of the path as written, not resolved, for one named by CLAUDE_CONFIG_DIR. Stored tokens are clacc's own.
keychain_service() {
  if [[ $1 == "$token" && -z $global ]]; then
    echo "Claude Code-credentials"
  elif [[ $1 == */.credentials.json ]]; then
    echo "Claude Code-credentials-$(printf %s "${1%/.credentials.json}" | shasum -a 256 | cut -c1-8)"
  else
    echo "clacc $1"
  fi
}

# Through stdin no other process can see the token, but security -i cuts a line beyond 4 KB and
# stores the rest, so a longer one has to go on the command line. A login with MCP tokens is longer.
keychain_write() {
  local service hex line
  service=$(keychain_service "$1")
  hex=$(printf %s "$2" | xxd -p | tr -d '\n')
  line="add-generic-password -U -a \"$keychain_user\" -s \"$service\" -X \"$hex\""
  if ((${#line} <= 4032)); then
    printf '%s\n' "$line" | security -i > /dev/null
  else
    security add-generic-password -U -a "$keychain_user" -s "$service" -X "$hex"
  fi
  [[ $(read_token "$1") == "$2" ]] || die "the Keychain did not store the token in '$service'"
}

keychain_delete() { security delete-generic-password -a "$keychain_user" -s "$(keychain_service "$1")" > /dev/null 2>&1; }

warn() { echo "clacc: $*" >&2; }

die() {
  warn "$@"
  exit 1
}

main "$@"
